<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Continue watching from other apps (Android TV "Watch Next") -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Self-updates from GitHub Releases -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Needed to list installed apps on Android 11+ (Apps screen). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Other home-screen apps (to tell whether Flux is the home screen, and for Home button takeover). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="com.google.android.libraries.tv.smarthome.intent.action.OPEN_SMART_HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">

            <!-- Lets Flux be chosen as the TV's home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SearchActivity" android:exported="${testExported}" android:screenOrientation="landscape"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".DetailActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".StreamsActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".AddonsActivity" android:exported="${testExported}" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AccountActivity" android:exported="${testExported}" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ServersActivity" android:exported="${testExported}" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SettingsActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".LiveActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".IptvActivity" android:exported="${testExported}" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ServiceActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fluxtv" android:host="service" />
            </intent-filter>
        </activity>
        <activity android:name=".ServiceShortcutActivity" android:exported="true" android:label="Flux service page"
            android:icon="@drawable/icon" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".CreditsActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".PersonActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".HomeRowsActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".DownloadsActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".ArrSetupActivity" android:exported="${testExported}" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan" />
        <activity android:name=".GenreActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity android:name=".ProfilesActivity" android:exported="${testExported}" android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan" />
        <!-- Its own entry in the app list, so Button Mapper can put it on a remote button. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="true"
            android:label="Flux Quick Settings"
            android:taskAffinity="com.fluxtv.app.quicksettings"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AppsActivity" android:exported="${testExported}" android:screenOrientation="landscape" />
        <activity
            android:name=".PlayerActivity"
            android:exported="${testExported}"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />
        <!-- Home button takeover (like Projectivy): turned on by the user in Settings → Accessibility. -->
        <service
            android:name=".HomeButtonService"
            android:exported="true"
            android:label="@string/home_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_service" />
        </service>
        <receiver android:name=".UpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
